# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# Learner data — never commit, in any form, including test fixtures.
# See SECURITY.md. Synthetic data only, and name it clearly as synthetic.
/learner-data/
*.learner-record
*.behavioural-record

# Node / web (for when implementation starts)
node_modules/
dist/
build/
.cache/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# PWA build output
sw.js.map
workbox-*.js

# Python (tooling, content pipelines)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Local scratch — keep working notes out of the repo.
# Anything worth keeping belongs in memory/ instead.
scratch/
tmp/
*.local.md
