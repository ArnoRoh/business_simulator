# Normalise line endings across contributors' platforms.
* text=auto eol=lf

*.md   text diff=markdown
*.yml  text
*.yaml text
*.json text
*.js   text
*.ts   text
*.html text
*.css  text
*.svg  text

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp3  binary
*.ogg  binary
*.woff binary
*.woff2 binary

